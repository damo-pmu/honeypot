# Honeypot Environment Configuration
# IMPORTANT: Never commit real API keys to git
# Copy to .env and fill in secrets for local development

# ===========================================
# Security Configuration
# Dashboard Security (CHANGE THIS IN PRODUCTION)
DASHBOARD_PASS=demo

# Honeypot public hostname / domain, used for CORS defaults
# Exemples : localhost, monhoneypot.local, monhoneypot.com
HONEYPOT_HOSTNAME=localhost

# CORS Allowed Origins (Phase 2 - restrict cross-origin requests)
# Format: comma-separated list, NO spaces after commas
# Examples:
#   Development: http://localhost:3000,http://localhost:8000
#   Production: https://dashboard.company.com,https://grafana.company.com
# Default: built from HONEYPOT_HOSTNAME for common frontend ports
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000,http://localhost:9090

# LLM Configuration
# For OpenRouter API (optional, local LLM preferred)
# Generate key at https://openrouter.ai
OPENROUTER_API_KEY=

# For local LLM model path (GPT4All, LlamaCpp)
# Default: uses rule-based classifier if not set
LOCAL_LLM_MODEL=

# Database
PG_PASS=demo

# Maintenance Scheduler intervals (seconds)
RETENTION_INTERVAL=86400   # daily (90 days)
HEALTHCHECK_INTERVAL=3600  # hourly

# Grafana (optional)
GRAFANA_PASS=demo

# ===========================================
# Service Hosts (for multi-host deployment)
# ===========================================
DB_HOST=postgres
DB_PORT=5432
DB_NAME=honeypot
REDIS_HOST=redis
REDIS_PORT=6379
RABBITMQ_HOST=rabbitmq
API_HOST=api

# Port Configuration
# ===========================================
API_PORT=8000
SSH_PORT=22
TELNET_PORT=23
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090

# ============================================================
# Tor Seed Configuration (realistic attack testing)
# ============================================================
# Your public IP - used to filter out your own traffic
PUBLIC_IP=

# Seed interval in seconds
SEED_INTERVAL=300