# Honeypot Environment Configuration
# IMPORTANT: Never commit real API keys to git
# Copy to .env and fill in secrets for local development

# ===========================================
# Security Configuration
# ===========================================
# Dashboard Auth - CHANGE IN PRODUCTION
DASHBOARD_PASSWORD=demo

# LLM Configuration (OpenRouter)
# Generate key at https://openrouter.ai
API_KEY_OPENROUTER=

# ===========================================
# Database Configuration  
# ===========================================
PG_PASS=demo

# ===========================================
# Port Configuration
# ===========================================
# API/Dashboard port
API_PORT=8000

# SSH honeypot port (Cowrie)
SSH_PORT=22

# Telnet honeypot port (Cowrie)
TELNET_PORT=23

# Grafana port
GRAFANA_PORT=3000

# Prometheus port
PROMETHEUS_PORT=9090

# Redis port
REDIS_PORT=6375

# ===========================================
# Grafana Configuration
# ===========================================
GRAFANA_PASSWORD=demo