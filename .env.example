# Honeypot Environment Configuration
# IMPORTANT: Never commit real API keys to git

# API Configuration
API_URL=http://api:8000

# Database
DATABASE_URL=postgresql://honeypot:secret@postgres:5432/honeypot

# Redis
REDIS_URL=redis://redis:6379

# LLM Configuration (OpenRouter - for production use, use GitHub secrets)
# Generate new key at https://openrouter.ai
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=laguna-m.1:free

# Dashboard Security (CHANGE THIS IN PRODUCTION)
DASHBOARD_PASSWORD=change-me-in-prod

# Cowrie Integration
COWRIE_LOG=/cowrie/var/log/cowrie.json