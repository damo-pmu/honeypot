# Honeypot Environment Configuration
# IMPORTANT: Never commit real API keys to git
# Copy to .env and fill in secrets for local development

# Dashboard Security (CHANGE THIS IN PRODUCTION)
DASHBOARD_PASSWORD=demo

# LLM Configuration (OpenRouter - use GitHub secrets in production)
# Generate new key at https://openrouter.ai
API_KEY_OPENROUTER=

# Database
PG_PASS=demo

# Grafana (optional)
GRAFANA_PASSWORD=demo