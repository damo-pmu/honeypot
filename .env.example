# Honeypot Environment Configuration
# IMPORTANT: Never commit real API keys to git
# Copy to .env and fill in secrets for local development

# ===========================================
# Security Configuration
# Dashboard Security (CHANGE THIS IN PRODUCTION)
DASHBOARD_PASS=demo

# LLM Configuration (OpenRouter)
# Generate key at https://openrouter.ai
API_KEY_OPENROUTER=

# Database
PG_PASS=demo

# Redis/RabbitMQ defaults
REDIS_URL=redis://redis:6379

# Grafana (optional)
GRAFANA_PASS=demo
GRAFANA_DB_PASSWORD=demo

# ===========================================
# Port Configuration
# ===========================================
API_PORT=8000
SSH_PORT=22
TELNET_PORT=23
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090