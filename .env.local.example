# Local secrets file - NOT tracked by git
# Copy from .env.local.example and fill in your values
# This file takes precedence over .env

# Security
DASHBOARD_PASS=your-secure-dashboard-password

# LLM
API_KEY_OPENROUTER=sk-or-your-openrouter-key

# Database (can be random)
PG_PASS=your-secure-postgres-password

# Grafana
GRAFANA_PASS=your-secure-grafana-password

# Optional: Override defaults
API_PORT=8000
SSH_PORT=22