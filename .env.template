# Hermes Webagency Environment Template
# Copy this file to .env and fill in your actual values
# IMPORTANT: Never commit this file to git - add .env to your .gitignore

# ===== GitHub Configuration =====
# For GitHub CLI authentication and API access
# Get your token from: https://github.com/settings/tokens
# Required scopes: repo, workflow (admin:org if needed for organization actions)
GITHUB_TOKEN=ghp_your_github_personal_access_token_here

# ===== Jira Configuration =====
# For Jira REST API access
# Get your API token from: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=your_jira_api_token_here
JIRA_EMAIL=your_email@yourcompany.com
JIRA_SERVER=https://yourcompany.atlassian.net

# ===== Optional: Additional Configuration =====
# Default editor for GitHub CLI (uncomment and modify if needed)
# GITHUB_EDITOR=code --wait

# Default output format for GitHub CLI (json, text, table)
# GITHUB_OUTPUT=json

# ===== Security Notes =====
# 1. This file contains sensitive authentication tokens
# 2. File permissions MUST be set to 600 (readable only by owner)
#    Run: chmod 600 .env
# 3. Never commit this file to version control
#    Ensure .env is in your .gitignore file
# 4. Use fine-grained tokens with minimal required scopes
# 5. Rotate tokens regularly and immediately if compromised

# ===== Validation =====
# After filling in your values, you can test the configuration with:
#   ./bin/verify-external-tools.sh
# or for verbose output:
#   ./bin/verify-external-tools.sh --verbose