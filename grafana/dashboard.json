{
  "dashboard": {
    "id": null,
    "uid": "honeypot-overview",
    "title": "Honeypot Security Dashboard",
    "tags": ["honeypot", "security"],
    "timezone": "browser",
    "schemaVersion": 38,
    "version": 1,
    "refresh": "5s",
    "panels": [
      {
        "type": "stat",
        "title": "Total Attacks (DB)",
        "gridPos": {"x": 0, "y": 0, "w": 4, "h": 4},
        "datasource": {"name": "PostgreSQL"},
        "targets": [{"rawSql": "SELECT COUNT(*) FROM attacks", "refId": "A"}]
      },
      {
        "type": "stat",
        "title": "Unique Attackers",
        "gridPos": {"x": 4, "y": 0, "w": 4, "h": 4},
        "datasource": {"name": "PostgreSQL"},
        "targets": [{"rawSql": "SELECT COUNT(DISTINCT attacker_ip) FROM attackers", "refId": "A"}]
      },
      {
        "type": "stat",
        "title": "Total IOCs",
        "gridPos": {"x": 8, "y": 0, "w": 4, "h": 4},
        "datasource": {"name": "PostgreSQL"},
        "targets": [{"rawSql": "SELECT COUNT(*) FROM ioc_indicators", "refId": "A"}]
      },
      {
        "type": "stat",
        "title": "Commands Logged",
        "gridPos": {"x": 12, "y": 0, "w": 4, "h": 4},
        "datasource": {"name": "PostgreSQL"},
        "targets": [{"rawSql": "SELECT COUNT(*) FROM commands", "refId": "A"}]
      },
      {
        "type": "timeseries",
        "title": "Attack Timeline (24h)",
        "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
        "datasource": {"name": "PostgreSQL"},
        "targets": [{
          "rawSql": "SELECT date_trunc('hour', timestamp) as time, attack_type, count(*) as attacks FROM attacks WHERE timestamp > NOW() - INTERVAL '24 hours' GROUP BY 1, 2 ORDER BY 1",
          "refId": "A"
        }]
      },
      {
        "type": "table",
        "title": "Top Attackers by Severity",
        "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8},
        "datasource": {"name": "PostgreSQL"},
        "targets": [{
          "rawSql": "SELECT DISTINCT ON (attacker_ip) attacker_ip, MAX(severity) as max_severity, COUNT(*) as attack_count FROM attacks GROUP BY attacker_ip ORDER BY max_severity DESC LIMIT 20",
          "refId": "A"
        }]
      },
      {
        "type": "table",
        "title": "Recent Attacks Feed",
        "gridPos": {"x": 0, "y": 12, "w": 12, "h": 8},
        "datasource": {"name": "PostgreSQL"},
        "targets": [{
          "rawSql": "SELECT timestamp, session_id, attacker_ip, attack_type, LEFT(payload, 50) as payload_snippet, severity FROM attacks ORDER BY timestamp DESC LIMIT 50",
          "refId": "A"
        }]
      },
      {
        "type": "barchart",
        "title": "Attack Types Distribution",
        "gridPos": {"x": 12, "y": 12, "w": 12, "h": 8},
        "datasource": {"name": "PostgreSQL"},
        "targets": [{
          "rawSql": "SELECT attack_type, COUNT(*) as count FROM attacks GROUP BY attack_type ORDER BY count DESC",
          "refId": "A"
        }]
      },
      {
        "type": "table",
        "title": "IOC Indicators by Hit Count",
        "gridPos": {"x": 0, "y": 20, "w": 12, "h": 8},
        "datasource": {"name": "PostgreSQL"},
        "targets": [{
          "rawSql": "SELECT ioc_type, value, hit_count, source, DATE(first_seen) as first_seen_date FROM ioc_indicators ORDER BY hit_count DESC LIMIT 30",
          "refId": "A"
        }]
      },
      {
        "type": "stat",
        "title": "Flagged Commands",
        "gridPos": {"x": 12, "y": 20, "w": 4, "h": 4},
        "datasource": {"name": "PostgreSQL"},
        "targets": [{"rawSql": "SELECT COUNT(*) FROM commands WHERE flagged = true", "refId": "A"}]
      },
      {
        "type": "stat",
        "title": "Avg Severity",
        "gridPos": {"x": 16, "y": 20, "w": 4, "h": 4},
        "datasource": {"name": "PostgreSQL"},
        "targets": [{"rawSql": "SELECT ROUND(AVG(severity)) FROM attacks", "refId": "A"}]
      }
    ]
  },
  "overwrite": true,
  "folderId": 0,
  "message": "Honeypot dashboard - PostgreSQL powered"
}