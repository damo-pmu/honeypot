[Unit]
Description=Cowrie SSH/Telnet Honeypot
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/test-honeypot
Environment="PATH=/home/ubuntu/.hermes/hermes-agent/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin"
Environment="PYTHONPATH=/home/ubuntu/.hermes/hermes-agent/venv/lib/python3.11/site-packages"
ExecStart=/home/ubuntu/.hermes/hermes-agent/venv/bin/python3 -m cowrie
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target