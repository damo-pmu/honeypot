[Unit]
Description=Honeypot Worker (Cowrie ingest)
After=network.target honeypot-api.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/test-honeypot
Environment="PATH=/home/ubuntu/bin:/home/ubuntu/.hermes/hermes-agent/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin"
Environment="API_URL=http://localhost:8000"
Environment="COWRIE_LOG=/home/ubuntu/test-honeypot/data/cowrie.json"
ExecStart=/home/ubuntu/.hermes/hermes-agent/venv/bin/python3 -m src.workers.cowrie_ingest
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target